# Copiá este archivo como .env y completá tus valores. El .env NUNCA se sube a GitHub.

# Dirección de PocketBase (la base de datos local).
POCKETBASE_URL=http://127.0.0.1:8090

# Servicio de cotización del dólar oficial (DolarAPI, público y sin clave).
DOLARAPI_URL=https://dolarapi.com/v1/dolares/oficial

# Más adelante se suman acá otras variables (por ejemplo, las del MCP de PocketBase
# y la clave de OpenAI del chat). Agregalas solo cuando la app las use.
